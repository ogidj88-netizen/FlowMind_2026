# --- FlowMind ignores (canon) ---

# Python runtime / cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# virtual environments
.venv/
venv/
env/

# temp / quarantine
tmp/
**/*.tmp
**/*.tmp.*
**/.tmp/
**/*~
**/#*#

# json quarantine outputs
tmp/_json_quarantine/

# one-off patchers (must not be committed)
tools/patch_*.py
tools/patch_*.sh

# --- project run outputs (do not commit by default) ---
projects/*/S8_*.json
projects/*/S9_*.json
projects/*/S10_*.json

# OS / IDE
.DS_Store
.vscode/
.idea/

# FlowMind: ignore test runtime outputs
projects/FM_HASH/S2_script.json
projects/FM_SMOKE_SINGLE_WRITER/
projects/FM_SMOKE_*/
projects/*SMOKE*/
projects/*SELFTEST*/
